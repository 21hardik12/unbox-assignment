# Backend service configuration (copy to .env for local, non-docker runs).
# In docker-compose these values are injected from the root .env / compose file.

# HTTP server (REST API + Socket.IO)
PORT=3001
HOST=0.0.0.0

# Comma-separated browser origins allowed for CORS / Socket.IO.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL / TimescaleDB connection
DATABASE_URL=postgres://speedometer:speedometer_dev_pw@localhost:5432/speedometer

# MQTT broker
MQTT_URL=mqtt://localhost:1883
# Topic the simulator publishes to; "+" is a single-level wildcard (any device).
MQTT_TOPIC=sensors/+/speed

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
NODE_ENV=development
