# Sensor simulator configuration (copy to .env for local, non-docker runs).

# MQTT broker to publish to.
MQTT_URL=mqtt://localhost:1883

# Logical sensor / vehicle id. Published topic is sensors/<DEVICE_ID>/speed.
DEVICE_ID=vehicle-01

# Sampling interval in milliseconds (assignment asks for 1 second).
INTERVAL_MS=1000

# Upper bound for the simulated speed, in km/h.
MAX_SPEED=220

LOG_LEVEL=info
NODE_ENV=development
