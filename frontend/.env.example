# Frontend build-time configuration (Vite exposes only VITE_*-prefixed vars).
# All are optional; the defaults target the same-origin proxy setup.

# Override the API / Socket.IO origin. Empty = same origin (recommended:
# the Vite dev proxy and the production nginx both serve API + sockets here).
VITE_API_URL=

# Device id to display / query history for. Must match the simulator's id.
VITE_DEVICE_ID=vehicle-01

# Speedometer dial maximum (km/h). Should match the simulator's MAX_SPEED.
VITE_MAX_SPEED=220
