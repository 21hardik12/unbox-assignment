# =============================================================================
# Root environment for docker-compose.
# Copy to ".env" (cp .env.example .env) and adjust as needed.
# docker-compose reads this file automatically. Every value has a safe default
# baked into docker-compose.yml, so the stack also boots with no .env at all.
# =============================================================================

# --- TimescaleDB / PostgreSQL ---
POSTGRES_USER=speedometer
POSTGRES_PASSWORD=speedometer_dev_pw
POSTGRES_DB=speedometer
# Host port exposed for ad-hoc psql access (container always listens on 5432).
TIMESCALE_PORT=5432

# --- Mosquitto MQTT broker ---
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- Backend (ingest + API + Socket.IO) ---
BACKEND_PORT=3001
# Comma-separated list of browser origins allowed to call the API / open a socket.
# In the dockerized stack the frontend is same-origin via nginx, so this mainly
# matters for local (non-docker) development against the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=info

# --- Sensor simulator ---
# Topic pattern is sensors/<deviceId>/speed
SIM_DEVICE_ID=vehicle-01
SIM_INTERVAL_MS=1000
# Speed model bounds (km/h)
SIM_MAX_SPEED=220

# --- Frontend (served by nginx) ---
FRONTEND_PORT=8080
